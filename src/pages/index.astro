---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import NebuFlagship from '../components/NebuFlagship.astro';
import SignalToAction from '../components/SignalToAction.astro';
import Systems from '../components/Systems.astro';
import Roadmap from '../components/Roadmap.astro';
import Investment from '../components/Investment.astro';
import Reliability from '../components/Reliability.astro';
import Value from '../components/Value.astro';
import Approach from '../components/Approach.astro';
import Sustainability from '../components/Sustainability.astro';
import DocsCta from '../components/DocsCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base
  title="CitySphere | NEBU — The city that acts before problems grow"
  description="CitySphere is a master developer and long-term operator of smart cities in Egypt. Its flagship NEBU connects the physical city, city teams, and citizens into one coordinated loop — acting before problems grow."
>
  <SiteHeader />
  <main>
    <Hero />
    <Problem />
    <NebuFlagship />
    <SignalToAction />
    <Systems />
    <Roadmap />
    <Investment />
    <Reliability />
    <Value />
    <Approach />
    <Sustainability />
    <DocsCta />
  </main>
  <SiteFooter />
</Base>
