        <img src={`${base}/logo-white.svg`} alt="CitySphere" />
        <p style="max-width: 38ch; margin: 0;">
          CitySphere creates smart cities that improve how people live, move, work, and grow.
        </p>
      </div>
      <div>
        <h4>Explore</h4>
        <p style="margin: 0;">
          <a href="#nebu">NEBU by CitySphere</a><br />
          <a href="#nebu">Operating model</a>
