---
const plans = [
  { id: '03', title: 'Project Schedule', desc: 'Sequences Approval → Requirements → Design → Build → Deploy → Test → Operate → Evaluate across 6 milestones and 8 workstreams.' },
  { id: '04', title: 'Resource Allocation', desc: 'Allocates human and technical resources within the USD 5M ceiling; the category budget is the controlling financial baseline.' },
  { id: '05', title: 'Communication', desc: 'Gets the right information to the right stakeholder via a single weekly status report and a lean meeting cadence.' },
  { id: '06', title: 'Risk Management', desc: 'Tracks 12 risks with owners, mitigations, and a USD 300k contingency reserve.' },
  { id: '07', title: 'Quality Assurance', desc: 'Tests 5 focus areas with a 48-hour critical non-conformance <abbr title="Service Level Agreement — the committed response time for critical issues">SLA</abbr> and continuous field testing.' },
];
const stats = [
  { n: 'USD 5M', l: 'Controlled pilot ceiling' },
  { n: 'Sep 2026 – Jul 2027', l: 'Planned delivery window' },
  { n: '8', l: 'Workstreams' },
  { n: '5', l: 'QA focus areas' },
  { n: '90%', l: 'Target system availability' },
];
---
<section class="section approach" id="approach">
  <div class="container">
    <span class="badge">Controlled pilot</span>
    <span class="eyebrow">How we deliver</span>
    <h2>Discipline behind the city</h2>
    <p class="lead">
      NEBU is delivered as a controlled pilot — measured, governed, and accountable. Five planning
      disciplines keep scope, budget, and quality on track.
    </p>

    <div class="plan-list">
      {
        plans.map((p) => (
          <div class="plan-item">
            <span class="plan-id">{p.id}</span>
            <div>
              <h3>{p.title}</h3>
              <p set:html={p.desc} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="stat-strip">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="stat-n">{s.n}</div>
            <div class="stat-l">{s.l}</div>
          </div>
        ))
      }
    </div>

    <div class="boundaries">
      <div class="boundary-box">
        <h3>In the pilot</h3>
        <ul>
          <li>Six connected systems, sensing and platform</li>
          <li>Operator workflows and dashboards</li>
          <li>A defined district as a controlled pilot</li>
          <li>Measured evaluation against success measures</li>
        </ul>
      </div>
      <div class="boundary-box">
        <h3>Not yet in scope</h3>
        <ul>
          <li>Full citywide rollout</li>
          <li>Large-scale predictive AI</li>
          <li>Autonomous transportation</li>
          <li>Third-party city services and public citizen app release</li>
        </ul>
      </div>
    </div>

    <p class="approach-note">
      A controlled pilot, not a citywide rollout — credibility earned through measured results.
    </p>

    <details class="glossary">
      <summary>Glossary &amp; key terms</summary>
      <dl>
        <div><dt>NEBU</dt><dd>CitySphere's flagship future city and the operating model that connects the physical city, digital systems, and citizens.</dd></div>
        <div><dt>IoT</dt><dd>Internet of Things — connected sensors and devices that capture real-time city data.</dd></div>
        <div><dt>QA</dt><dd>Quality Assurance — testing across five focus areas with a 48-hour critical non-conformance SLA.</dd></div>
        <div><dt>SLA</dt><dd>Service Level Agreement — the committed response time for critical issues (48 hours here).</dd></div>
        <div><dt>Workstream</dt><dd>One of eight delivery streams (e.g. mobility, energy, operations) sequenced across the pilot.</dd></div>
        <div><dt>Contingency reserve</dt><dd>A USD 300k buffer held against the 12 tracked delivery risks.</dd></div>
      </dl>
    </details>
  </div>
</section>
