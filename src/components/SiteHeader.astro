---
import { base } from 'astro:config/client';
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={`${base}/`} aria-label="CitySphere — home">
      <img class="brand-icon" src={`${base}/favicon.svg`} alt="CitySphere" />
      <span class="brand-name">CitySphere</span>
    </a>
    <nav aria-label="Primary">
      <a class="nav-link" href={`${base}/`}>Home</a>
      <a class="nav-link" href={`${base}/#nebu`}>NEBU</a>
      <a class="nav-link" href={`${base}/#systems`}>Systems</a>
      <a class="nav-link" href={`${base}/#approach`}>Approach</a>
      <a class="nav-link" href={`${base}/documents`}>Planning documents</a>
    </nav>
  </div>
</header>
