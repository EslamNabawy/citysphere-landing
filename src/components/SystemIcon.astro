---
const { name } = Astro.props;
---
<svg
  class="feature-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mobility' && (
    <>
      <path d="M4 14h3l2-5h5l2 5h4" />
      <circle cx="9" cy="16" r="1.3" />
      <circle cx="15" cy="16" r="1.3" />
      <path d="M12 4v4" />
    </>
  )}
  {name === 'waste' && (
    <>
      <path d="M5 7h14l-1.4 13h-11.2z" />
      <path d="M9 7V4h6v3" />
      <path d="M5 13h14" />
    </>
  )}
  {name === 'energy' && (
    <path d="M3 13c2.5-6 5.5 6 8 0s5.5-6 8 0" />
  )}
  {name === 'operations' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <path d="M7 15l3-3 2 2 5-5" />
      <path d="M7 8h2" />
    </>
  )}
  {name === 'citizen' && (
    <>
      <rect x="5" y="4" width="14" height="16" rx="2" />
      <path d="M9 13h6" />
      <circle cx="12" cy="9.5" r="1.2" />
    </>
  )}
  {name === 'connectivity' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 4v16" />
      <path d="M4 12h16" />
    </>
  )}
  {name === 'cyber' && (
    <>
      <path d="M12 3l7 3v5c0 4.2-3 7.2-7 8-4-0.8-7-3.8-7-8V6z" />
      <path d="M9 12l2 2 4-4" />
    </>
  )}
  {name === 'realm' && (
    <>
      <path d="M5 20V9a7 7 0 0 1 14 0v11" />
      <path d="M5 20h14" />
    </>
  )}
</svg>
